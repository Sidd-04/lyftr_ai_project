# Lyftr AI Configuration

# Comma-separated API keys pool for failover (at least 2 keys)
# In order: key_1, key_2, ...
LLM_API_KEYS=your_first_gemini_or_openai_api_key_here,your_second_gemini_or_openai_api_key_here

# SQLite database file path (lives inside Docker volume /data)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Failover test hook enablement
ENABLE_FAILURE_SIMULATION=true

# Default LLM model for LiteLLM gateway
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Set to true only if testing without active internet/API keys
MOCK_LLM=false

# Frontend API base URL (for production deployments, e.g. on Vercel)
VITE_BACKEND_URL=
